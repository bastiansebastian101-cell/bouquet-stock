# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# local sqlite db (dev only — production uses Postgres)
/prisma/dev.db
/prisma/dev.db-journal

# user-uploaded photos in local dev (production uses Vercel Blob)
/public/flower-images/*
!/public/flower-images/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
